# Sao chép thành .env (đã gitignore). Máy dev: giữ WP_ENV_TYPE=local; production: đặt WP_ENV_TYPE=production.
# URL công khai của WP (WP_HOME/WP_SITEURL). Đổi khi chạy sau nginx gốc / staging / production.
WP_URL=http://localhost:8089
WP_PORT=8089
WP_BIND_ADDR=127.0.0.1
# local | development | staging => noindex. Bỏ trống/production => cho lập chỉ mục (an toàn cho production).
WP_ENV_TYPE=local
# production: true khi đã có TLS
WP_FORCE_SSL_ADMIN=false

# CSDL (chỉ local; production dùng giá trị ngẫu nhiên riêng)
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=change-me-local-only
WP_DB_ROOT_PASSWORD=change-me-local-only-root

# Tài khoản quản trị tạo bởi scripts/setup.sh. Bỏ trống mật khẩu → script sinh ngẫu nhiên và in ra một lần.
WP_ADMIN_USER=hvadmin
WP_ADMIN_EMAIL=admin@example.invalid
WP_ADMIN_PASSWORD=

# Nguồn Flatsome (chỉ đọc) để scripts/install-themes.sh sao chép vào wp-content/themes/flatsome
FLATSOME_SRC=/Users/phuc/Documents/HV_QR_BOOKING/deploy/local/wp-content/themes/flatsome

# Bí mật dùng chung WP <-> server Next cho GET /wp-json/haivan-web/v1/promo-codes (header X-HV-Secret). Sinh ngẫu nhiên: openssl rand -hex 24.
# Cùng giá trị đặt ở HV_WP_SHARED_SECRET của apps/booking/.env.local. Không commit giá trị thật.
HV_WP_SHARED_SECRET=
