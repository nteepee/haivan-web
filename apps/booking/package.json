{
  "name": "@haivan/booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "smoke": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/smoke.ts",
    "build:verify": "HV_BUILD_OFFLINE=1 NEXT_DIST_DIR=.next-verify NEXT_PUBLIC_CMS_URL=http://127.0.0.1:9 NEXT_PUBLIC_APIGW_URL=http://127.0.0.1:9 WP_LAYOUT_URL= next build && NEXT_DIST_DIR=.next-verify node scripts/check-ssr-h1.mjs --home-only",
    "contract-diff": "vitest run --config scripts/vitest.config.mts scripts/contract-diff.test.ts",
    "test:scripts": "vitest run --config scripts/vitest.config.mts",
    "check:ssr-h1": "node scripts/check-ssr-h1.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "iron-session": "^9.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
