# Backend Hải Vân (production-only). BFF dùng APIGW_URL (chỉ server); trình duyệt dùng NEXT_PUBLIC_*.
APIGW_URL=https://apigw.haivan.com
NEXT_PUBLIC_APIGW_URL=https://apigw.haivan.com
NEXT_PUBLIC_CMS_URL=https://cms.haivan.com

# Site key reCAPTCHA v2 công khai của web haivan.com cũ (điền khi triển khai)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Origin công khai, dùng cho kiểm tra CSRF và return_url
PUBLIC_ORIGIN=https://haivan.com

# REST layout của WordPress (menu/footer)
WP_LAYOUT_URL=https://haivan.com/wp-json/haivan-web/v1/layout

# Khoá mã hoá cookie phiên (>= 32 ký tự ngẫu nhiên), không commit giá trị thật
SESSION_SECRET=

# CPN (hàng hoá) — chưa dùng trong phạm vi hiện tại, khai báo để E2E/mock trỏ được
CPN_URL=https://api.cpn.haivanexpress.vn
NEXT_PUBLIC_CPN_URL=https://api.cpn.haivanexpress.vn

# Cổng an toàn của BFF (mặc định tắt). Backend không phải loopback cần HV_LIVE_BACKEND=1;
# thao tác ghi thật (giữ chỗ, đặt vé, thanh toán, huỷ, đăng nhập) cần thêm HV_LIVE_WRITES=1.
# Production: cả hai = 1. Dev xem dữ liệu thật (chỉ đọc): HV_LIVE_BACKEND=1.
HV_LIVE_BACKEND=0
HV_LIVE_WRITES=0

# Tile bản đồ (OSM mặc định giới hạn production)
NEXT_PUBLIC_MAP_TILE_URL=

# Mã khuyến mãi khứ hồi tự áp (ẩn): Next (server) đọc mã thật từ route riêng của WordPress bằng bí mật dùng chung; mã không bao giờ tới trình duyệt.
# Route mặc định: <gốc WP>/wp-json/haivan-web/v1/promo-codes (đổi bằng HV_WP_PROMO_CODES_URL), header X-HV-Secret.
# HV_WP_SHARED_SECRET: cùng giá trị với HV_WP_SHARED_SECRET phía WordPress, >= 16 ký tự (openssl rand -hex 24), xoay định kỳ.
# WP_ROUTE_URL: gốc WP (không có /wp-json); bỏ trống thì suy từ WP_LAYOUT_URL.
HV_WP_SHARED_SECRET=
WP_ROUTE_URL=
HV_WP_PROMO_CODES_URL=
